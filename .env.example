# ============================================================
#  Obieg dokumentów — konfiguracja (skopiuj do .env)
#  Sekretów (klucz Anthropic, hasła, OAuth) NIE wpisujesz tutaj —
#  uzupełnia się je w n8n: Overview -> Credentials.
# ============================================================

# --- n8n / serwer ---
N8N_VERSION=2.40.7
N8N_HOST_PORT=5678
# Nazwa kontenera (na serwerze z innymi usługami nie może kolidować z istniejącym „n8n”)
N8N_CONTAINER=obieg-n8n
# Limity pamięci (Mikrus współdzielony z innymi usługami: 600m / 400 / 200)
N8N_MEM_LIMIT=850m
N8N_NODE_MAX_OLD_SPACE=460
N8N_RUNNERS_MAX_OLD_SPACE=256
# Mikrus: subdomena z panelu, np. twojafirma.wykr.es ; lokalnie: localhost
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
# lokalnie po http: false ; na Mikrusie (https): true
N8N_SECURE_COOKIE=false
# Za reverse proxy (Mikrus/Cloudflare) ustaw 1
N8N_PROXY_HOPS=0
# Klucz szyfrujący credentials — wygeneruj raz (openssl rand -hex 32) i NIGDY nie zmieniaj.
N8N_ENCRYPTION_KEY=

# --- Google Drive: ID folderów (wypełnia workflow „00 Instalacja”) ---
DRIVE_FOLDER_WEJSCIE=
DRIVE_FOLDER_W_TRAKCIE=
DRIVE_FOLDER_WERYFIKACJA=
DRIVE_FOLDER_ARCHIWUM=
DRIVE_FOLDER_EKSPORT=
DRIVE_FOLDER_BLEDY=
# --- Google Sheets: rejestr dokumentów ---
SHEET_REJESTR_ID=

# --- Poczta ---
# Folder/etykieta Gmaila z fakturami (np. INBOX albo Faktury)
IMAP_MAILBOX=INBOX
NOTIFY_EMAIL_FROM=obieg-dokumentow@twojafirma.pl
NOTIFY_EMAIL_TO=ksiegowosc@twojafirma.pl

# --- Reguły ---
# NIP naszej firmy (ostrzeżenie, gdy faktura wystawiona na inny podmiot)
NIP_FIRMY=
# Schemat nazwy pliku: {data} {rrrr} {mm} {dd} {typ} {nip} {kontrahent} {numer} {oryginal}
FILENAME_TEMPLATE={data}_{typ}_{nip}_{numer}
# Tolerancje zaokrągleń w groszach: na pozycji / na dokumencie
TOL_LINE_GR=2
TOL_DOC_GR=5
# Poniżej tej pewności odczytu dokument jest czytany ponownie mocniejszym modelem
MIN_PEWNOSC=0.8
# Ile plików pobierać z folderu wejściowego w jednym przebiegu (co minutę)
POLL_BATCH_SIZE=10
